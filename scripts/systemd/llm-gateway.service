[Unit]
Description=Pickle campus LLM API gateway (OpenAI-compatible proxy)
Documentation=https://github.com/pnuops/pickle-llm-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pickle-llmgw
Group=pickle-llmgw
# Listen address, snapshot/spool paths and upstream credentials. The daemon
# fails closed when a required value is missing.
EnvironmentFile=/etc/pickle/llm-gateway.env
ExecStart=/opt/pickle/llm-gateway/bin/llm-gateway
# SIGHUP re-reads the snapshot document immediately.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# Holds the snapshot document and the usage spool.
StateDirectory=pickle-llm-gateway
StateDirectoryMode=0750
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=

# Hardening. The gateway spawns no child processes and only speaks TCP.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RemoveIPC=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# Resource ceilings, sized from the 2026-09-02 in-flight measurement rather
# than from a guess. An in-flight request costs about 240 KB at the realistic
# response ceiling and exactly two file descriptors; 1,024 of them peaked at
# 248 MB and 2,061 descriptors, and thread use plateaus in the low tens.
# LimitNOFILE is the value that actually bounds concurrency here, so it is set
# far above the in-flight cap rather than just above it.
LimitNOFILE=65535
TasksMax=512
# The ceilings answer to the large-body pools, not to normal traffic. Each of
# the sixteen chat large-body slots, all of which one key may hold, can hold a
# 128 MiB answer (or one stream event of that size), which costs about three times its size once GOMEMLIMIT
# presses, and the sixteen passthrough slots about 1.75 times theirs: about
# 6.4 GiB plus 4.7 GiB with every slot full at once. Normal load sits orders of
# magnitude under it. These numbers assume a 16 GiB container; a smaller host
# lowers the pool sizes in the environment file together with the three
# values below, and a container smaller than MemoryMax silently makes the
# container's limit the real one, with GOMEMLIMIT then above it.
#
# MemoryMax stays below the container's own limit on purpose, and the gap is
# not spare capacity — it decides which process dies. Were the two equal, the
# container's cgroup would hit its limit at the same moment and its OOM killer
# would choose among everything in the container, systemd and journald
# included: nothing left to restart the daemon, and nothing left to record why.
# Below it, the daemon always reaches its own ceiling first and dies alone.
# The gap only has to cover the rest of the container, which measured 12 MB
# idle plus page cache, so 512 MB is already generous.
MemoryMax=15872M
# A rung below the kill, so pressure from such an upstream shows up as
# throttling and reclaim in the logs while the service still answers. Without
# it the first symptom is a SIGKILL, and a restart takes every in-memory
# rate-limit bucket with it — an OOM loop is a limit bypass.
MemoryHigh=14848M
# Go sizes its heap from the machine, not from the cgroup, so without this it
# grows toward twice the live heap and the cgroup kills the process before the
# collector runs. Kept below both rungs so the collector acts first, and above
# the full-pool figure above, which is the pressed one: with every slot full
# the collector is working hard, not losing.
# Note it governs the Go heap only: socket buffers count against MemoryMax and
# are invisible here, which is why each gap below MemoryMax is a gigabyte or
# more while the one above it, to the container, stays at 512 MB.
Environment=GOMEMLIMIT=13312MiB

[Install]
WantedBy=multi-user.target
