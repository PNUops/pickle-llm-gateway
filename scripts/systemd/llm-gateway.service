[Unit]
Description=Pickle campus LLM API gateway (OpenAI-compatible proxy)
Documentation=https://github.com/pnuops/pickle-llm-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pickle-llmgw
Group=pickle-llmgw
# Listen address, snapshot/spool paths and upstream credentials. The daemon
# fails closed when a required value is missing.
EnvironmentFile=/etc/pickle/llm-gateway.env
ExecStart=/opt/pickle/llm-gateway/bin/llm-gateway
# SIGHUP re-reads the snapshot document immediately.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# Holds the snapshot document and the usage spool.
StateDirectory=pickle-llm-gateway
StateDirectoryMode=0750
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=

# Hardening. The gateway spawns no child processes and only speaks TCP.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RemoveIPC=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# Resource ceilings, sized from the 2026-09-02 in-flight measurement rather
# than from a guess. An in-flight request costs about 240 KB at the realistic
# response ceiling and exactly two file descriptors; 1,024 of them peaked at
# 248 MB and 2,061 descriptors, and thread use plateaus in the low tens.
# LimitNOFILE is the value that actually bounds concurrency here, so it is set
# far above the in-flight cap rather than just above it.
LimitNOFILE=65535
TasksMax=512
# The ceilings answer to the response read cap, not to normal traffic. A
# response near that cap costs about 13 MB to buffer, decode and re-serialise,
# so what the ladder below has to survive is a broken or hostile upstream
# returning those in bulk — normal load sits two orders of magnitude under it.
# Raising the in-flight cap moved that failure closer, which is why these grew
# with it rather than after it.
#
# MemoryMax stays below the container's own limit on purpose, and the gap is
# not spare capacity — it decides which process dies. Were the two equal, the
# container's cgroup would hit its limit at the same moment and its OOM killer
# would choose among everything in the container, systemd and journald
# included: nothing left to restart the daemon, and nothing left to record why.
# Below it, the daemon always reaches its own ceiling first and dies alone.
# The gap only has to cover the rest of the container, which measured 12 MB
# idle plus page cache, so 512 MB is already generous.
MemoryMax=3584M
# A rung below the kill, so pressure from such an upstream shows up as
# throttling and reclaim in the logs while the service still answers. Without
# it the first symptom is a SIGKILL, and a restart takes every in-memory
# rate-limit bucket with it — an OOM loop is a limit bypass.
MemoryHigh=3072M
# Go sizes its heap from the machine, not from the cgroup, so without this it
# grows toward twice the live heap and the cgroup kills the process before the
# collector runs. Kept below both rungs so the collector acts first. Note it
# governs the Go heap only: socket buffers count against MemoryMax and are
# invisible here, which is part of why the gap to MemoryMax is wide.
Environment=GOMEMLIMIT=2560MiB

[Install]
WantedBy=multi-user.target
